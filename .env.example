# Optional. Use Bekim's confirmed direct HTTPS link to the review form.
# PUBLIC_REVIEW_URL=

# Use a persistent directory and a unique password for the booking server.
# BOOKING_DB_PATH=data/bookings.sqlite
# BOOKING_ADMIN_PASSWORD=

# Vercel server and build variables. Set the same token as a Supabase Edge Function secret.
# BOOKING_BACKEND_URL=https://<project-ref>.supabase.co/functions/v1/booking
# BOOKING_BACKEND_TOKEN=

# Supabase Auth. These values enable the staff login in Vercel.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
