---
interface Props
{
    name: 'pin' | 'route' | 'clock' | 'chevron' | 'menu' | 'close' | 'check' | 'scissors' | 'calendar' | 'star';
    class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
    class:list={['icon', className]}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
>
    {name === 'pin' && <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.7"/></>}
    {name === 'route' && <path d="m21 3-6.5 18-3.6-7.9L3 9.5 21 3Z"/>}
    {name === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
    {name === 'chevron' && <path d="m9 5 7 7-7 7"/>}
    {name === 'menu' && <path d="M3 6h18M3 12h18M3 18h18"/>}
    {name === 'close' && <path d="m5 5 14 14M19 5 5 19"/>}
    {name === 'check' && <path d="m4 12 5 5L20 6"/>}
    {name === 'scissors' && <><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M8 8l12 12M8 16l12-12"/></>}
    {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18"/></>}
    {name === 'star' && <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>}
</svg>

<style lang="scss">
    .icon {
        display: inline-block;
        width: 1.25rem;
        height: 1.25rem;
        flex: 0 0 auto;
        vertical-align: middle;
    }
</style>
