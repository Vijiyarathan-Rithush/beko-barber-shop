---
import { routes, shop } from '../config/shop';
---

<footer class="site-footer">
    <div class="layout-width footer-content">
        <div>
            <a class="footer-brand" href={routes.home}>{shop.name}</a>
            <address>{shop.address}</address>
        </div>
        <div class="footer-links">
            {shop.phone && <a href={'tel:' + shop.phone.replaceAll(' ', '')}>{shop.phone}</a>}
            {shop.instagramUrl && <a href={shop.instagramUrl}>Instagram</a>}
            <a href={shop.directionsUrl}>Route planen</a>
        </div>
    </div>
</footer>

<style lang="scss">
    .site-footer {
        padding: 1.5rem 0;
        border-top: 1px solid var(--line);
        background: #0c0c0c;
        color: var(--muted);
        font-size: .875rem;
    }

    .footer-content,
    .footer-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .65rem 1.25rem;
    }

    .footer-content {
        justify-content: space-between;
    }

    .footer-brand {
        color: var(--text);
        font-family: var(--heading-font);
        font-size: 1.5rem;
        font-weight: 800;
        text-decoration: none;
        text-transform: uppercase;
    }

    .footer-links a {
        display: inline-flex;
        min-height: 2.75rem;
        align-items: center;
    }

    .footer-links a:hover {
        color: var(--accent-hover);
    }
</style>
