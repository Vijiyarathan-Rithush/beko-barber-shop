---
import { Image } from 'astro:assets';
import storefront from '../assets/barbershop-storefront.jpg';
import Icon from './Icon.astro';
import { shop } from '../config/shop';
---

<section class="location-section" id="standort" tabindex="-1" aria-labelledby="location-heading">
    <div class="location-info">
        <h2 class="section-title" id="location-heading">Standort</h2>
        <address class="location-row">
            <Icon name="pin" />
            <span>{shop.streetAddress}<br />{shop.locality}</span>
        </address>
        <a class="text-action location-row" href={shop.directionsUrl}>
            <Icon name="route" />
            Route planen
        </a>
        <div class="location-row hours">
            <Icon name="clock" />
            {shop.openingHours.length ? (
                <div>{shop.openingHours.map((entry) => <p>{entry}</p>)}</div>
            ) : (
                <p>Öffnungszeiten folgen</p>
            )}
        </div>
    </div>
    <figure class="location-image">
        <Image
            src={storefront}
            alt="Aussenansicht von Beko’s Barber Shop in St. Gallen"
            widths={[480, 768, 960]}
            sizes="(min-width: 832px) 55vw, 100vw"
            format="webp"
            quality={76}
        />
    </figure>
</section>

<style lang="scss">
    .location-section {
        display: grid;
        gap: 1.7rem;
        padding: 1.65rem 0 2.2rem;
    }

    .location-info {
        min-width: 0;
    }

    .location-row {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        gap: .75rem;
        margin-top: .65rem;
        text-align: left;
    }

    .location-row :global(.icon) {
        width: 1.35rem;
        height: 1.35rem;
        margin-top: .13rem;
        color: var(--accent);
    }

    address.location-row {
        margin-top: 1.3rem;
        font-weight: 600;
        line-height: 1.48;
    }

    a.location-row {
        align-items: center;
        font-size: .93rem;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .hours {
        color: var(--muted);
        font-size: .9rem;
    }

    .location-image {
        align-self: start;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
    }

    .location-image img {
        display: block;
        width: 100%;
        height: auto;
    }

    @media (min-width: 52rem) {
        .location-section {
            grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
            gap: 3rem;
            padding: 2.4rem 0 3rem;
        }
    }
</style>
