---
import { Image } from 'astro:assets';
import locationIllustration from '../assets/location-illustration.png';
import Icon from './Icon.astro';
import { shop } from '../config/shop';
---

<section class="location-section" id="standort" tabindex="-1" aria-labelledby="location-heading">
    <div class="location-info">
        <h2 class="section-title" id="location-heading">Standort</h2>
        <address class="location-row">
            <Icon name="pin" />
            <span>{shop.streetAddress}<br />{shop.locality}</span>
        </address>
        <a class="text-action location-row" href={shop.directionsUrl}>
            <Icon name="route" />
            Route planen
        </a>
        <div class="location-row hours">
            <Icon name="clock" />
            {shop.openingHours.length ? (
                <div>{shop.openingHours.map((entry) => <p>{entry}</p>)}</div>
            ) : (
                <p>Öffnungszeiten folgen</p>
            )}
        </div>
    </div>
    <figure class="location-image">
        <Image
            src={locationIllustration}
            alt=""
            widths={[480, 768, 960]}
            sizes="(min-width: 832px) 55vw, 100vw"
            format="webp"
            quality={76}
        />
        <div class="map-marker" aria-hidden="true">
            <Icon name="pin" />
        </div>
        <figcaption>Kartenillustration</figcaption>
    </figure>
</section>

<style lang="scss">
    .location-section {
        display: grid;
        gap: 1.7rem;
        padding: 1.65rem 0 2.2rem;
    }

    .location-info {
        min-width: 0;
    }

    .location-row {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        gap: .75rem;
        margin-top: .65rem;
        text-align: left;
    }

    .location-row :global(.icon) {
        width: 1.35rem;
        height: 1.35rem;
        margin-top: .13rem;
        color: var(--accent);
    }

    address.location-row {
        margin-top: 1.3rem;
        font-weight: 600;
        line-height: 1.48;
    }

    a.location-row {
        align-items: center;
        font-size: .93rem;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .hours {
        color: var(--muted);
        font-size: .9rem;
    }

    .location-image {
        position: relative;
        display: grid;
        min-height: 11.5rem;
        place-items: center;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
    }

    .location-image img {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .map-marker {
        position: relative;
        display: grid;
        width: 2.85rem;
        height: 2.85rem;
        place-items: center;
        border: 2px solid var(--background);
        border-radius: 50%;
        background: var(--accent);
        color: var(--on-accent);
        box-shadow: 0 0 0 .45rem rgb(233 78 0 / .2);
    }

    .map-marker :global(.icon) {
        width: 1.55rem;
        height: 1.55rem;
    }

    figcaption {
        position: absolute;
        right: .65rem;
        bottom: .65rem;
        padding: .2rem .45rem;
        border-radius: .2rem;
        background: var(--background);
        color: var(--muted);
        font-size: .75rem;
    }

    @media (min-width: 52rem) {
        .location-section {
            grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
            gap: 3rem;
            padding: 2.4rem 0 3rem;
        }

        .location-image {
            min-height: 14rem;
        }
    }
</style>
