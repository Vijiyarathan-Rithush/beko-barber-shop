---
import Icon from './Icon.astro';
import { routes, shop } from '../config/shop';

interface Props
{
    bookingPage: boolean;
}

const { bookingPage } = Astro.props;
const staffLogin = typeof __BEKO_STAFF_LOGIN__ !== 'undefined' && __BEKO_STAFF_LOGIN__;
const onStaffLogin = Astro.url.pathname.replace(/\/$/, '') === routes.staffLogin.replace(/\/$/, '');
---

<header class="site-header" data-site-header data-staff-login={staffLogin ? '' : undefined}>
    <div class="header-content layout-width">
        <a class="brand" href={routes.home} aria-label="Beko’s Barber Shop, Startseite">
            {shop.logoPath && <img src={shop.logoPath} alt="" width="56" height="56" />}
            <span class="brand-type" aria-hidden="true">
                <strong>BEKO’S</strong>
                <span>BARBER SHOP</span>
            </span>
        </a>
        {staffLogin && (
            <a class="staff-login" href={routes.staffLogin} aria-current={onStaffLogin ? 'page' : undefined}>
                Login<span class="sr-only"> für Mitarbeitende</span>
            </a>
        )}
        <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle hidden>
            <Icon name="menu" class="menu-open-icon" />
            <Icon name="close" class="menu-close-icon" />
        </button>
        <nav id="site-navigation" aria-label="Hauptnavigation" data-menu>
            <a href={routes.home + '#leistungen'}>Leistungen</a>
            <a href={routes.home + '#bewertungen'}>Bewertungen</a>
            <a href={routes.home + '#standort'}>Standort</a>
            <a class="action nav-booking" href={routes.booking} aria-current={bookingPage ? 'page' : undefined}>Termin buchen</a>
        </nav>
    </div>
</header>

<script>
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = header?.querySelector<HTMLElement>('[data-menu]');

    if (header && toggle && menu)
    {
        const desktop = window.matchMedia('(min-width: 49rem)');

        function closeMenu(): void
        {
            toggle?.setAttribute('aria-expanded', 'false');
            toggle?.setAttribute('aria-label', 'Menü öffnen');
        }

        header.dataset.menuReady = '';
        toggle.hidden = false;
        toggle.addEventListener('click', () =>
        {
            if (toggle.getAttribute('aria-expanded') === 'true')
            {
                closeMenu();
                return;
            }

            toggle.setAttribute('aria-expanded', 'true');
            toggle.setAttribute('aria-label', 'Menü schliessen');
        });

        header.addEventListener('keydown', (event) =>
        {
            if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true')
            {
                closeMenu();
                toggle.focus();
            }
        });

        menu.addEventListener('click', (event) =>
        {
            if (!(event.target instanceof Element))
            {
                return;
            }

            const link = event.target.closest<HTMLAnchorElement>('a');
            if (!link || desktop.matches)
            {
                return;
            }

            closeMenu();
            if (link.pathname === window.location.pathname && link.hash)
            {
                const section = document.getElementById(link.hash.slice(1));
                section?.focus({ preventScroll: true });
            }
        });

        desktop.addEventListener('change', closeMenu);
    }
</script>

<style lang="scss">
    .site-header {
        position: relative;
        z-index: 5;
        border-bottom: 1px solid var(--line);
        background: var(--background);
    }

    .header-content {
        display: flex;
        min-height: var(--header-height);
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
    }

    .brand {
        display: inline-flex;
        min-height: 2.75rem;
        align-items: center;
        gap: .8rem;
        text-decoration: none;
    }

    .brand img {
        object-fit: contain;
        mix-blend-mode: lighten;
    }

    .brand-type {
        display: grid;
        gap: .13rem;
        padding-left: .65rem;
        border-left: 2px solid var(--accent);
        line-height: 1;
    }

    .brand img + .brand-type {
        border-left: 1px solid var(--control-line);
    }

    .brand-type strong {
        font-family: var(--heading-font);
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: .035em;
    }

    .brand-type span {
        font-size: .63rem;
        font-weight: 700;
        letter-spacing: .21em;
    }

    .staff-login {
        display: inline-flex;
        min-height: 2.75rem;
        flex: none;
        align-items: center;
        margin-inline: auto .45rem;
        padding-inline: .7rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        color: var(--text);
        font-size: .875rem;
        font-weight: 700;
        text-decoration: none;
    }

    .staff-login:hover,
    .staff-login[aria-current='page'] {
        border-color: var(--accent);
        color: var(--accent-hover);
    }

    @media (max-width: 24rem) {
        [data-staff-login] .brand { gap: .55rem; }
        [data-staff-login] .brand img { width: 2.75rem; height: 2.75rem; }
        [data-staff-login] .brand-type { padding-left: .5rem; }
        [data-staff-login] .brand-type strong { font-size: 1.65rem; }
    }

    .menu-toggle {
        display: grid;
        width: 2.75rem;
        min-height: 2.75rem;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: transparent;
    }

    .menu-toggle:hover {
        border-color: var(--control-line);
    }

    .menu-toggle :global(.icon) {
        width: 1.45rem;
        height: 1.45rem;
    }

    .menu-toggle :global(.menu-close-icon),
    .menu-toggle[aria-expanded='true'] :global(.menu-open-icon) {
        display: none;
    }

    .menu-toggle[aria-expanded='true'] :global(.menu-close-icon) {
        display: block;
    }

    nav {
        display: flex;
        width: 100%;
        flex-direction: column;
        gap: .4rem;
        padding: .55rem 0 1rem;
        border-top: 1px solid var(--line);
    }

    [data-menu-ready] .menu-toggle[aria-expanded='false'] + nav {
        display: none;
    }

    nav a:not(.action) {
        display: flex;
        min-height: 2.75rem;
        align-items: center;
        color: var(--text);
        font-size: .94rem;
        font-weight: 600;
        text-decoration: none;
    }

    nav a:not(.action):hover {
        color: var(--accent-hover);
    }

    .nav-booking {
        align-self: flex-start;
    }

    @media (min-width: 49rem) {
        .header-content {
            flex-wrap: nowrap;
            gap: 1.5rem;
        }

        .menu-toggle {
            display: none;
        }

        [data-staff-login] .header-content { gap: clamp(.7rem, 1.75vw, 1.5rem); }
        [data-staff-login] { --navigation-gap: clamp(.75rem, 1.7vw, 2.65rem); }
        .staff-login { margin-inline-end: 0; }

        nav,
        [data-menu-ready] .menu-toggle[aria-expanded='false'] + nav {
            display: flex;
            width: auto;
            flex-direction: row;
            align-items: center;
            gap: var(--navigation-gap, clamp(1rem, 2.7vw, 2.65rem));
            padding: 0;
            border: 0;
        }

        .nav-booking {
            align-self: center;
        }

    }
</style>
