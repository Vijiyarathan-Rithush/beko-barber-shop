---
import { staffAccount } from '../../../../supabase/functions/_shared/staffAccount';
import StaffForm from './StaffForm.astro';
import { sameOrigin, staffAuth, staffSession } from './staffAuth';

Astro.response.headers.set('Cache-Control', 'private, no-store');
// Preserve the Origin on the password form POST for the CSRF check.
Astro.response.headers.set('Referrer-Policy', 'same-origin');
let error: string | undefined;
let invite = '';

if (Astro.request.method === 'POST')
{
    if (!sameOrigin(Astro.request, Astro.url))
    {
        return new Response(null, { status: 403, headers: { 'Cache-Control': 'no-store' } });
    }

    const fields = await Astro.request.formData().catch(() => undefined);
    const token = fields?.get('invite');
    const password = fields?.get('password');
    const confirmation = fields?.get('confirmation');
    invite = typeof token === 'string' && /^[A-Za-z0-9_=-]{24,128}$/.test(token) ? token : '';

    if (typeof password !== 'string' || password.length < 12 || password.length > 72 || password !== confirmation)
    {
        error = 'Gib dasselbe Passwort zweimal ein. Es muss mindestens 12 Zeichen lang sein.';
    }
    else
    {
        const client = staffAuth(Astro);
        let authorized = false;
        if (invite)
        {
            const { data, error: verificationError } = await client.auth.verifyOtp({ token_hash: invite, type: 'invite' });
            authorized = !verificationError && Boolean(staffAccount(data.user));
            invite = '';
            if (!authorized && data.session)
            {
                await client.auth.signOut({ scope: 'local' });
            }
        }
        else
        {
            authorized = Boolean(await staffSession(client));
        }

        if (authorized)
        {
            const { error: updateError } = await client.auth.updateUser({ password });
            if (!updateError)
            {
                return Astro.redirect('/verwaltung/', 303);
            }

            error = 'Das Passwort konnte nicht gespeichert werden. Verwende ein anderes Passwort oder versuche es erneut.';
        }
        else
        {
            error = 'Öffne den Einladungslink aus deiner E-Mail. Dieser Link fehlt oder ist abgelaufen.';
        }
    }
}
---

<StaffForm title="Passwort festlegen" {error}>
    <form method="post" action="/verwaltung/passwort-waehlen/">
        <input type="hidden" name="invite" value={invite} data-staff-invite />
        <label>Neues Passwort
            <input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="72" required />
        </label>
        <label>Passwort wiederholen
            <input name="confirmation" type="password" autocomplete="new-password" minlength="12" maxlength="72" required />
        </label>
        <button type="submit" class="action">Passwort speichern</button>
    </form>
    <a class="form-link" href="/verwaltung/anmelden/">Zur Anmeldung</a>
</StaffForm>

<script>
    const invite = new URLSearchParams(window.location.hash.slice(1)).get('einladung');
    const input = document.querySelector<HTMLInputElement>('[data-staff-invite]');
    if (invite && input)
    {
        input.value = invite;
        window.history.replaceState(null, '', window.location.pathname);
    }
</script>
