---
import type { StaffAccount } from '../../../../supabase/functions/_shared/staffAccount';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { staffAuth, staffSession } from './staffAuth';
import { callStaffBackend } from './staffGateway';

Astro.response.headers.set('Cache-Control', 'private, no-store');
const session = await staffSession(staffAuth(Astro));
if (!session)
{
    return Astro.redirect('/verwaltung/anmelden/', 303);
}
if (session.account.role !== 'admin')
{
    return new Response('Dieser Bereich ist für den Admin reserviert.', {
        status: 403,
        headers: { 'Cache-Control': 'private, no-store' }
    });
}

let accounts: StaffAccount[];
try
{
    accounts = await (await callStaffBackend(session.accessToken, 'staff-accounts')).json() as StaffAccount[];
}
catch
{
    return new Response('Die Zugänge konnten vorübergehend nicht geladen werden.', {
        status: 503,
        headers: { 'Cache-Control': 'private, no-store' }
    });
}
---

<BaseLayout title="Adminbereich | Beko’s Barber Shop" description="Geschützter Adminbereich für die Terminverwaltung.">
    <section class="layout-width admin">
        <a href="/verwaltung/">Zurück zu den Terminen</a>
        <h1>Adminbereich</h1>
        <h2>Zugänge</h2>
        <ul>
            {accounts.map(({ role, email }) => (
                <li>
                    <strong>{role === 'admin' ? 'Admin' : 'Bekim'}</strong>
                    <span>{email}</span>
                </li>
            ))}
        </ul>
    </section>
</BaseLayout>

<style lang="scss">
    .admin { padding-block: clamp(2rem, 7vw, 4rem); }
    h1 { font-size: clamp(2.5rem, 8vw, 4rem); margin: .6rem 0 1.4rem; }
    h2 { font-size: 1.7rem; }
    ul { list-style: none; margin: 0; padding: 0; }
    li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .4rem 1rem; padding: .85rem 0; border-bottom: 1px solid var(--line); }
    span { overflow-wrap: anywhere; }
</style>
