---
import { createHash, timingSafeEqual } from 'node:crypto';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { cancelBooking, upcomingBookings } from './bookingStore';

const password = process.env.BOOKING_ADMIN_PASSWORD;
const auth = Astro.request.headers.get('authorization') ?? '';
const supplied = Buffer.from(auth.slice(6), 'base64').toString('utf8');
const hash = (value: string) => createHash('sha256').update(value).digest();

Astro.response.headers.set('Cache-Control', 'private, no-store');

if (!password || !auth.startsWith('Basic ') || !timingSafeEqual(hash(supplied), hash('bekim:' + password)))
{
    return new Response('Anmeldung erforderlich', {
        status: 401,
        headers: {
            'WWW-Authenticate': 'Basic realm="Beko Booking", charset="UTF-8"',
            'Cache-Control': 'private, no-store'
        }
    });
}

if (Astro.request.method === 'POST')
{
    if (Astro.request.headers.get('origin') !== Astro.url.origin)
    {
        return new Response('Ungültiger Ursprung', { status: 403, headers: { 'Cache-Control': 'no-store' } });
    }

    const fields = await Astro.request.formData();
    const id = fields.get('id');
    if (typeof id !== 'string' || !/^[a-f0-9-]{36}$/.test(id))
    {
        return new Response('Ungültiger Termin', { status: 400, headers: { 'Cache-Control': 'no-store' } });
    }

    cancelBooking(id);
    return Astro.redirect(Astro.url.pathname, 303);
}

const bookings = upcomingBookings();
const date = new Intl.DateTimeFormat('de-CH', {
    timeZone: 'Europe/Zurich',
    dateStyle: 'medium',
    timeStyle: 'short'
});
---

<BaseLayout title="Bekims Termine | Beko’s Barber Shop" description="Terminverwaltung für Bekim.">
    <section class="layout-width management">
        <h1>Bekims Termine</h1>
        {bookings.length ? (
            <ul>
                {bookings.map((booking) => (
                    <li>
                        <div>
                            <h2>{booking.service}</h2>
                            <p>{date.format(booking.startsAt)} · CHF {booking.priceChf}</p>
                            <p>{booking.name} · {booking.email}</p>
                        </div>
                        <form method="post">
                            <input type="hidden" name="id" value={booking.id} />
                            <button class="action action--outline" type="submit">Termin stornieren</button>
                        </form>
                    </li>
                ))}
            </ul>
        ) : (
            <p>Es gibt keine kommenden Termine.</p>
        )}
    </section>
</BaseLayout>

<style lang="scss">
    .management { padding-block: 2rem; }
    h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); margin-bottom: 1rem; }
    ul { list-style: none; margin: 0; padding: 0; }
    li {
        display: flex;
        flex-wrap: wrap;
        gap: .8rem 1.5rem;
        align-items: center;
        justify-content: space-between;
        padding-block: 1rem;
        border-bottom: 1px solid var(--line);
    }
    h2 { font-size: 1.7rem; margin-bottom: .3rem; }
    p { overflow-wrap: anywhere; }
</style>
