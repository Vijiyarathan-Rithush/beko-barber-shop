{
    "name": "beko-barber-shop",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@11.19.1",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "dev": "astro dev",
        "check": "astro check",
        "build": "astro build",
        "build:pages": "astro build --config astro.pages.config.mjs",
        "preview": "astro preview",
        "build:booking": "astro build --config astro.booking.config.mjs",
        "start:booking": "node --env-file-if-exists=.env dist-booking/server/entry.mjs",
        "test:booking": "npm run build:booking && node --test tests/booking.integration.test.mjs"
    },
    "dependencies": {
        "@astrojs/node": "11.1.14",
        "@fontsource/barlow-condensed": "^5.2.0",
        "@fontsource/inter": "^5.2.0",
        "@js-temporal/polyfill": "0.5.1",
        "astro": "7.4.13"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.4",
        "@types/node": "22.20.7",
        "sass": "^1.86.0",
        "typescript": "~5.9.3"
    }
}
